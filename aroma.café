<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Doces & Aromas Café</title>

    <!-- Fontes -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link
        href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;600;700&family=Poppins:wght@300;400;500;600&display=swap"
        rel="stylesheet">

    <!-- CSS -->
    <link rel="stylesheet" href="estilo.css">
</head>

<body>

    <!-- CABEÇALHO -->
    <header>

        <div class="logo">
            <span class="icone-cafe">☕</span>
            <h1>Doces & Aromas</h1>
            <p>Café</p>
        </div>

        <nav>
            <ul>
                <li><a href="#sobre">Sobre</a></li>
                <li><a href="#cardapio">Cardápio</a></li>
                <li><a href="#depoimentos">Depoimentos</a></li>
                <li><a href="#reservas">Reservas</a></li>
            </ul>
        </nav>

    </header>


    <main>

        <!-- SOBRE -->
        <section id="sobre" class="sobre">

            <h2>Um lugar para apreciar cada momento</h2>

            <img
                src="cafe.png.png"
                alt="Interior aconchegante do Doces & Aromas Café, com mesas de madeira e pessoas tomando café">

            <div class="sobre-texto">

                <p>
                    Desde 2015, o <strong>Doces & Aromas Café</strong> serve café especial
                    torrado artesanalmente, em um ambiente pensado para quem gosta de
                    trabalhar, ler ou simplesmente conversar com calma.
                </p>

                <p>
                    Nossos grãos vêm de pequenos produtores parceiros e cada xícara
                    é preparada na hora, valorizando o sabor e o aroma de um bom café.
                </p>

            </div>

            <div class="horario">

                <h3>☕ Venha nos visitar</h3>

                <p>
                    Terça a domingo · 8h às 19h
                </p>

                <p>
                    Café da manhã · Brunch · Doces · Salgados
                </p>

            </div>

        </section>


        <!-- CARDÁPIO -->
        <section class="cardapio">
    <h2>Nosso Cardápio</h2>

    <div class="cardapio-grid">

        <div class="cardapio-item">
            <img src="Café-expresso-1.jpg" alt="Café expresso">
            <h3>Expresso</h3>
            <p>Café espresso extraído na hora, blend especial da casa.</p>
            <span>R$ 6,00</span>
        </div>

        <div class="cardapio-item">
            <img src="cappucino1.jpg" alt="Cappuccino">
            <h3>Cappuccino Aroma</h3>
            <p>Espresso, leite vaporizado e canela em pó.</p>
            <span>R$ 9,50</span>
        </div>

        <div class="cardapio-item">
            <img src="prensa francesa.jpg" alt="Prensa francesa">
            <h3>Prensa Francesa</h3>
            <p>Café preparado na prensa francesa, servido em bule individual.</p>
            <span>R$ 12,00</span>
        </div>

         <div class="cardapio-item">
            <img src="torrada de abacate.jpg" alt="Torrada de Abacate">
            <h3>Torrada de Abacate</h3>
            <p>Pão artesanal, abacate amassado, ovo pochê e especiarias.</p>
            <span>R$ 18,00</span>
        </div>

         <div class="cardapio-item">
            <img src="bolo de fuba.jpg" alt="Bolo de Fuba">
            <h3>Bolo de Fubá</h3>
            <p>Fatia de bolo de fubá cremoso com goiabada.</p>
            <span>R$ 10,00</span>
        </div>

    </div>
</section>

        <!-- DEPOIMENTOS -->
        <section id="depoimentos" class="depoimentos">

            <h2>O que dizem nossos clientes</h2>

            <div class="avaliacoes">

                <article class="avaliacao">

                    <div class="estrelas">
                        ★★★★★
                    </div>

                    <p>
                        "O melhor cappuccino da região, e o ambiente
                        é super tranquilo para trabalhar."
                    </p>

                    <strong>— Marina T.</strong>

                </article>


                <article class="avaliacao">

                    <div class="estrelas">
                        ★★★★★
                    </div>

                    <p>
                        "Virei cliente fiel só pela torrada de abacate.
                        Recomendo demais!"
                    </p>

                    <strong>— Rafael S.</strong>

                </article>


                <article class="avaliacao">

                    <div class="estrelas">
                        ★★★★★
                    </div>

                    <p>
                        "Atendimento excelente e o café é sempre
                        fresquinho."
                    </p>

                    <strong>— Beatriz L.</strong>

                </article>

            </div>

        </section>


        <!-- RESERVAS -->
        <section id="reservas" class="reservas">

            <h2>Reserve sua mesa</h2>

            <p class="texto-reserva">
                Escolha o melhor dia para aproveitar nosso café.
            </p>

            <form action="#" method="post">

                <div class="infos">

                    <label for="nome">
                        Nome completo
                    </label>

                    <input
                        type="text"
                        id="nome"
                        name="nome"
                        placeholder="Digite seu nome"
                        required>

                </div>


                <div class="infos">

                    <label for="email">
                        E-mail
                    </label>

                    <input
                        type="email"
                        id="email"
                        name="email"
                        placeholder="seuemail@email.com"
                        required>

                </div>


                <div class="infos">

                    <label for="data">
                        Data da reserva
                    </label>

                    <input
                        type="date"
                        id="data"
                        name="data"
                        required>

                </div>


                <div class="infos">

                    <label for="pessoas">
                        Número de pessoas
                    </label>

                    <input
                        type="number"
                        id="pessoas"
                        name="pessoas"
                        min="1"
                        max="12"
                        placeholder="Ex.: 2"
                        required>

                </div>


                <button type="submit">
                    Confirmar reserva
                </button>

            </form>

        </section>

    </main>


    <!-- RODAPÉ -->
    <footer>

        <p>
            Doces & Aromas Café
        </p>

        <p>
            Rua das Flores, 245 · Centro
        </p>

        <p>
            Telefone: (51) 0000-0000
        </p>

        <p>
            contato@docesearomascafe.com
        </p>

        <div class="copyright">
            © 2026 Doces & Aromas Café · Todos os direitos reservados
        </div>

    </footer>

</body>

</html>
